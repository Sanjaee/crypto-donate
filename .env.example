# ============================================================
# MediaShare SaaS - Environment Template
# Salin ke .env lalu isi nilai nyata.
# JANGAN PERNAH commit .env ke Git.
# ============================================================

APP_ENV=development
PORT=8080

# --- PostgreSQL (Docker Compose / local) ---
DATABASE_URL=postgres://mediashare:CHANGE_ME@postgres:5432/mediashare?sslmode=disable

POSTGRES_DB=mediashare
POSTGRES_USER=mediashare
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=GENERATE_WITH__npx_auth_secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# --- Midtrans ---
MIDTRANS_SERVER_KEY=CHANGE_ME
MIDTRANS_CLIENT_KEY=CHANGE_ME
MIDTRANS_IS_PRODUCTION=false

# Dev-only: true = tidak panggil Midtrans sungguhan (untuk tes lokal).
MOCK_MIDTRANS=false

# --- Cloudinary (media image storage) ---
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CHANGE_ME

# --- UploadThing (opsional) ---
UPLOADTHING_TOKEN=

# --- Internal service token (Next.js <-> Go, WAJIB diubah) ---
INTERNAL_API_TOKEN=CHANGE_ME_RANDOM_64_HEX

# --- Platform fee (persen integer, contoh 5 = 5%) ---
PLATFORM_FEE_PERCENT=5

# --- Public URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Internal Go API URL (Next.js server -> Go, tanpa Nginx) ---
API_INTERNAL_URL=http://localhost:8080/api

# --- Midtrans Snap (client side) ---
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=CHANGE_ME
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# --- CORS allowed origins (comma separated) ---
CORS_ORIGINS=http://localhost:3000
