# ============================================================
# MediaShare SaaS - Environment Template
# Salin ke .env lalu isi nilai nyata.
# JANGAN PERNAH commit .env ke Git.
# ============================================================

APP_ENV=development
PORT=8080

# --- PostgreSQL (Docker Compose / local) ---
DATABASE_URL=postgres://mediashare:CHANGE_ME@postgres:5432/mediashare?sslmode=disable

POSTGRES_DB=mediashare
POSTGRES_USER=mediashare
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=GENERATE_WITH__npx_auth_secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# --- Plisio (crypto payments) ---
# Host sama untuk sandbox & production; dibedakan oleh tipe API key.
# Sandbox key -> mode uji, production key -> transaksi sungguhan.
PLISIO_API_KEY=CHANGE_ME
PLISIO_PRODUCTION=false
# PLISIO_BASE_URL (opsional) default: https://api.plisio.net/api/v1

# --- Cloudinary (media image storage) ---
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CHANGE_ME

# --- UploadThing (opsional) ---
UPLOADTHING_TOKEN=

# --- Internal service token (Next.js <-> Go, WAJIB diubah) ---
INTERNAL_API_TOKEN=CHANGE_ME_RANDOM_64_HEX

# --- Platform fee (persen integer, contoh 5 = 5%) ---
PLATFORM_FEE_PERCENT=5

# --- Admin emails (role otomatis jadi ADMIN, pisah koma) ---
ADMIN_EMAILS=admin@example.com

# --- Public URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Internal Go API URL (Next.js server -> Go, tanpa Nginx) ---
API_INTERNAL_URL=http://localhost:8080/api

# --- CORS allowed origins (comma separated) ---
CORS_ORIGINS=http://localhost:3000

# --- PLG Logging (Loki / Promtail / Grafana) ---
# Retensi log di Loki (jam). Default 168 = 7 hari.
LOKI_RETENTION_HOURS=168
# Credential login Grafana (akses http://localhost:3001).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# URL publik/domain Grafana bila diakses via nginx, contoh: https://grafana.domain.com
GRAFANA_ROOT_URL=http://localhost:3001
